# Single configuration file for Docker, backend, Prisma and frontend.
# Copy this template to the root .env for a new installation.
POSTGRES_DB=lis
POSTGRES_USER=lis
POSTGRES_PASSWORD=replace-with-a-unique-random-password
JWT_SECRET=replace-with-a-long-random-secret-before-production
PORT=4000
NODE_ENV=development
CORS_ORIGIN=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
# Standalone commands derive DATABASE_URL from POSTGRES_* above if omitted.
# Set DATABASE_URL only to use a different standalone/hosted database.
# Docker uses its internal database host and POSTGRES_* credentials.
HOSPITAL_NAME=Akash Diagnostic Center
HOSPITAL_ADDRESS=Bhiwani Chungi, Bhiwani Road, Rohtak 124001, Haryana
HOSPITAL_PHONE=7206620626
HOSPITAL_PATIENT_API_URL=
HOSPITAL_PATIENT_API_TOKEN=
FRONTEND_PORT=8081
VITE_API_URL=/api
# Local Vite development proxies /api to the backend PORT above.
LIS_VERSION=1.1.0

# Server-side daily backup. Create this folder before starting Docker Compose.
# Use forward slashes for an HDD destination, e.g. E:/LIS-backups.
LIS_BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=30

# Optional HMS lookup: api (existing HTTP adapter), mssql, or disabled.
# Leave api with an empty URL until your HMS integration is configured.
HOSPITAL_PATIENT_PROVIDER=api
HMS_SQL_SERVER=
HMS_SQL_PORT=1433
HMS_SQL_REQUEST_TIMEOUT_MS=30000
HMS_SQL_DATABASE=
HMS_SQL_USER=
HMS_SQL_PASSWORD=
HMS_SQL_PATIENT_VIEW=dbo.LisPatientLookup
HMS_SQL_ENCRYPT=true
HMS_SQL_TRUST_SERVER_CERTIFICATE=false
