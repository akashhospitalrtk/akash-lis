# Values used by docker compose. Copy to .env only when you need to override defaults.
POSTGRES_DB=lis
POSTGRES_USER=lis
POSTGRES_PASSWORD=lis_dev_password
JWT_SECRET=replace-with-a-long-random-secret-before-production
HOSPITAL_NAME=Akash Diagnostic Center
HOSPITAL_ADDRESS=Bhiwani Chungi, Bhiwani Road, Rohtak 124001, Haryana
HOSPITAL_PHONE=7206620626
HOSPITAL_PATIENT_API_URL=
HOSPITAL_PATIENT_API_TOKEN=
FRONTEND_PORT=8081
VITE_API_URL=/api
LIS_VERSION=1.1.0

# Server-side daily backup. Create this folder before starting Docker Compose.
# Use forward slashes for an HDD destination, e.g. E:/LIS-backups.
LIS_BACKUP_DIR=./backups
BACKUP_INTERVAL_SECONDS=86400

# Optional HMS lookup: api (existing HTTP adapter), mssql, or disabled.
# Leave api with an empty URL until your HMS integration is configured.
HOSPITAL_PATIENT_PROVIDER=api
HMS_SQL_SERVER=
HMS_SQL_PORT=1433
HMS_SQL_DATABASE=
HMS_SQL_USER=
HMS_SQL_PASSWORD=
HMS_SQL_PATIENT_VIEW=dbo.LisPatientLookup
HMS_SQL_ENCRYPT=true
HMS_SQL_TRUST_SERVER_CERTIFICATE=false
