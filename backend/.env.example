PORT=4000
DATABASE_URL=postgresql://lis:lis_dev_pass@localhost:5432/lis
JWT_SECRET=replace-with-a-long-random-secret
# Use production only behind HTTPS. Generate a new, private value (32+ characters).
NODE_ENV=development
# Comma-separated browser origins permitted to call the API. Leave blank only when
# frontend and API are served from the same origin behind a reverse proxy.
CORS_ORIGIN=
# Use only when PostgreSQL is remote and configured with a trusted TLS certificate.
DATABASE_SSL=false
HOSPITAL_NAME=Akash Diagnostic Center
HOSPITAL_ADDRESS=Bhiwani Chungi, Bhiwani Road, Rohtak 124001, Haryana
HOSPITAL_PHONE=7206620626
# Optional read-only hospital patient lookup adapter
HOSPITAL_PATIENT_API_URL=
HOSPITAL_PATIENT_API_TOKEN=
