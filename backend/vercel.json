{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run prisma:generate && node scripts/prepare-vercel.mjs",
  "outputDirectory": ".",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.ts": {
      "includeFiles": "assets/**",
      "maxDuration": 60
    }
  }
}
