{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run prisma:generate && node scripts/prepare-vercel.mjs",
  "functions": {
    "src/app.ts": {
      "includeFiles": "assets/**",
      "maxDuration": 60
    }
  }
}
